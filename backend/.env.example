# =============================================================================
# BizCore Backend — Variables d'environnement (modèle)
# Copiez ce fichier en `.env` puis remplissez les valeurs.
# En PaaS (Railway/Render/Fly), définissez ces mêmes variables dans le dashboard.
# NE COMMITTEZ JAMAIS le `.env` rempli.
# =============================================================================

# --- Profil Spring -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# --- Base de données PostgreSQL ---------------------------------------------
# En PaaS, utilisez l'URL/identifiants de la base managée.
POSTGRES_DB=bizcore
POSTGRES_USER=bizcore
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
# URL JDBC complète (prioritaire). Pour Postgres managé, adaptez l'hôte/port :
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bizcore
SPRING_DATASOURCE_USERNAME=bizcore
SPRING_DATASOURCE_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort

# --- Sécurité JWT ------------------------------------------------------------
# OBLIGATOIRE : clé d'au moins 256 bits. Générez-en une avec :
#   openssl rand -base64 48
JWT_SECRET=CHANGEZ_MOI_cle_secrete_forte_min_256_bits
JWT_EXPIRATION=86400000

# --- CORS --------------------------------------------------------------------
# Domaines frontend autorisés à appeler l'API (séparés par des virgules).
# Exemples :
#   https://bizcore.vercel.app
#   https://bizcore.vercel.app,https://*.vercel.app   (prévisualisations Vercel)
#   https://app.mondomaine.com
APP_CORS_ALLOWED_ORIGINS=https://CHANGEZ_MOI.vercel.app

# --- Redis (rate-limiting / cache) ------------------------------------------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# --- Kafka (notifications) ---------------------------------------------------
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=bizcore-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# --- Serveur / logs ----------------------------------------------------------
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_BIZCORE=INFO
