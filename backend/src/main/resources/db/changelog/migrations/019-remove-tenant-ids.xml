<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!--
    Migration 019 — SUPPRIMER tenant_id INUTILES
    Toutes les entités (sauf TENANT, USER, BUSINESS, SERVICE_REQUEST) héritent du tenant via leurs parents.
    - PORTFOLIO → hérite via ACTOR → USER
    - BUSINESS_RULE → hérite via BUSINESS
    - RESOURCE → hérite via BUSINESS
    - SERVICE_CATALOGUE → hérite via BUSINESS
    - INVOICE → hérite via SERVICE_REQUEST → ACTOR → USER
    
    Les FK directs vers tenants sont supprimés.
  -->

  <!-- ── PORTFOLIO : supprimer tenant_id ── -->
  <changeSet id="019-drop-portfolio-tenant-fk" author="bizcore">
    <preConditions onFail="MARK_RAN">
      <foreignKeyConstraintExists foreignKeyName="fk_portfolios_tenant"/>
    </preConditions>
    <dropForeignKeyConstraint
      baseTableName="portfolios"
      constraintName="fk_portfolios_tenant"/>
  </changeSet>
  <changeSet id="019-drop-portfolio-tenant-id" author="bizcore">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="portfolios" columnName="tenant_id"/>
    </preConditions>
    <dropColumn tableName="portfolios" columnName="tenant_id"/>
  </changeSet>

