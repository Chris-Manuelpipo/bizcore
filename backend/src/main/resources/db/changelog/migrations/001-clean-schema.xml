<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!--
    Schema complet BizCore refactoré — Sprint 4
    USER = fusion Person + AppUser
    ACTOR → USER (supprime tenant_id)
    BUSINESS enrichi (typeOfInvolvedActors, requiredJobProfiles)
    MEDIA (name, url, type, description, business_id)
    SERVICE_REQUEST → SERVICE_CATALOGUE (supprime business_id, +traceId)
    Tenant par défaut
  -->

  <!-- ── TENANTS ── -->
  <changeSet id="001" author="bizcore">
    <createTable tableName="tenants">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="varchar(255)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="domain" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="text"/>
      <column name="is_active" type="boolean" defaultValueBoolean="true"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <createIndex tableName="tenants" indexName="idx_tenants_domain">
      <column name="domain"/>
    </createIndex>
    <createIndex tableName="tenants" indexName="idx_tenants_active">
      <column name="is_active"/>
    </createIndex>
  </changeSet>

  <!-- ── USERS (fusion Person + AppUser) ── -->
  <changeSet id="002" author="bizcore">
    <createTable tableName="users">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="tenant_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="first_name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="last_name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="email" type="varchar(255)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="password" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="phone" type="varchar(255)"/>
      <column name="country" type="varchar(255)"/>
      <column name="is_active" type="boolean" defaultValueBoolean="true"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_users_tenant"
      baseTableName="users"
      baseColumnNames="tenant_id"
      referencedTableName="tenants"
      referencedColumnNames="id"/>
    <createIndex tableName="users" indexName="idx_users_tenant_id">
      <column name="tenant_id"/>
    </createIndex>
    <createIndex tableName="users" indexName="idx_users_email">
      <column name="email"/>
    </createIndex>
  </changeSet>

  <!-- ── USER_ROLES ── -->
  <changeSet id="003" author="bizcore">
    <createTable tableName="user_roles">
      <column name="user_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="role" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="user_roles" columnNames="user_id, role"/>
    <addForeignKeyConstraint
      constraintName="fk_user_roles_user"
      baseTableName="user_roles"
      baseColumnNames="user_id"
      referencedTableName="users"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex tableName="user_roles" indexName="idx_user_roles_user_id">
      <column name="user_id"/>
    </createIndex>
  </changeSet>

  <!-- ── BUSINESSES ── -->
  <changeSet id="004" author="bizcore">
    <createTable tableName="businesses">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="tenant_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="domain" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="text"/>
      <column name="type_of_involved_actors" type="text"/>
      <column name="required_job_profiles" type="text"/>
      <column name="is_active" type="boolean" defaultValueBoolean="true"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_businesses_tenant"
      baseTableName="businesses"
      baseColumnNames="tenant_id"
      referencedTableName="tenants"
      referencedColumnNames="id"/>
    <createIndex tableName="businesses" indexName="idx_businesses_tenant_id">
      <column name="tenant_id"/>
    </createIndex>
    <createIndex tableName="businesses" indexName="idx_businesses_domain">
      <column name="domain"/>
    </createIndex>
  </changeSet>

  <!-- ── ACTORS ── -->
  <changeSet id="005" author="bizcore">
    <createTable tableName="actors">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="user_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="role" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="bio" type="text"/>
      <column name="is_active" type="boolean" defaultValueBoolean="true"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_actors_user"
      baseTableName="actors"
      baseColumnNames="user_id"
      referencedTableName="users"
      referencedColumnNames="id"/>
    <createIndex tableName="actors" indexName="idx_actors_user_id">
      <column name="user_id"/>
    </createIndex>
    <createIndex tableName="actors" indexName="idx_actors_role">
      <column name="role"/>
    </createIndex>
  </changeSet>

  <!-- ── PORTFOLIOS + PORTFOLIO_BUSINESSES ── -->
  <changeSet id="006" author="bizcore">
    <createTable tableName="portfolios">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="text"/>
      <column name="created_at" type="timestamp"/>
    </createTable>

    <createTable tableName="portfolio_businesses">
      <column name="portfolio_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="business_id" type="uuid">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="portfolio_businesses" columnNames="portfolio_id, business_id"/>
    <addForeignKeyConstraint
      constraintName="fk_pb_portfolio"
      baseTableName="portfolio_businesses"
      baseColumnNames="portfolio_id"
      referencedTableName="portfolios"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <addForeignKeyConstraint
      constraintName="fk_pb_business"
      baseTableName="portfolio_businesses"
      baseColumnNames="business_id"
      referencedTableName="businesses"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
  </changeSet>

  <!-- ── BUSINESS_RULES ── -->
  <changeSet id="007" author="bizcore">
    <createTable tableName="business_rules">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="business_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="rule_key" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="text"/>
      <column name="rule_value" type="text"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_br_business"
      baseTableName="business_rules"
      baseColumnNames="business_id"
      referencedTableName="businesses"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex tableName="business_rules" indexName="idx_br_business_id">
      <column name="business_id"/>
    </createIndex>
  </changeSet>

  <!-- ── SERVICE_CATALOGUES ── -->
  <changeSet id="008" author="bizcore">
    <createTable tableName="service_catalogues">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="business_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="text"/>
      <column name="base_price" type="decimal(12,2)"/>
      <column name="currency" type="varchar(10)"/>
      <column name="is_active" type="boolean" defaultValueBoolean="true"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_sc_business"
      baseTableName="service_catalogues"
      baseColumnNames="business_id"
      referencedTableName="businesses"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex tableName="service_catalogues" indexName="idx_sc_business_id">
      <column name="business_id"/>
    </createIndex>
  </changeSet>

  <!-- ── RESOURCES ── -->
  <changeSet id="009" author="bizcore">
    <createTable tableName="resources">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="business_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="type" type="varchar(255)"/>
      <column name="capacity" type="int"/>
      <column name="availability" type="boolean" defaultValueBoolean="true"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_resources_business"
      baseTableName="resources"
      baseColumnNames="business_id"
      referencedTableName="businesses"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex tableName="resources" indexName="idx_resources_business_id">
      <column name="business_id"/>
    </createIndex>
  </changeSet>

  <!-- ── SERVICE_REQUESTS ── -->
  <changeSet id="010" author="bizcore">
    <createTable tableName="service_requests">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="tenant_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="consumer_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="provider_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="service_catalogue_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="trace_id" type="uuid"/>
      <column name="correlation_id" type="uuid"/>
      <column name="service_name" type="varchar(255)"/>
      <column name="description" type="text"/>
      <column name="status" type="varchar(50)"/>
      <column name="accepted_at" type="timestamp"/>
      <column name="started_at" type="timestamp"/>
      <column name="cancelled_at" type="timestamp"/>
      <column name="fulfilled_at" type="timestamp"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_sr_tenant"
      baseTableName="service_requests"
      baseColumnNames="tenant_id"
      referencedTableName="tenants"
      referencedColumnNames="id"/>
    <addForeignKeyConstraint
      constraintName="fk_sr_consumer"
      baseTableName="service_requests"
      baseColumnNames="consumer_id"
      referencedTableName="actors"
      referencedColumnNames="id"/>
    <addForeignKeyConstraint
      constraintName="fk_sr_provider"
      baseTableName="service_requests"
      baseColumnNames="provider_id"
      referencedTableName="actors"
      referencedColumnNames="id"/>
    <addForeignKeyConstraint
      constraintName="fk_sr_catalogue"
      baseTableName="service_requests"
      baseColumnNames="service_catalogue_id"
      referencedTableName="service_catalogues"
      referencedColumnNames="id"/>
    <createIndex tableName="service_requests" indexName="idx_sr_tenant_status">
      <column name="tenant_id"/>
      <column name="status"/>
    </createIndex>
    <createIndex tableName="service_requests" indexName="idx_sr_trace_id">
      <column name="trace_id"/>
    </createIndex>
    <createIndex tableName="service_requests" indexName="idx_sr_service_catalogue_id">
      <column name="service_catalogue_id"/>
    </createIndex>
  </changeSet>

  <!-- ── INVOICES ── -->
  <changeSet id="011" author="bizcore">
    <createTable tableName="invoices">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="service_request_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="amount" type="decimal(12,2)">
        <constraints nullable="false"/>
      </column>
      <column name="currency" type="varchar(10)"/>
      <column name="status" type="varchar(50)"/>
      <column name="paid_at" type="timestamp"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_invoices_sr"
      baseTableName="invoices"
      baseColumnNames="service_request_id"
      referencedTableName="service_requests"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex tableName="invoices" indexName="idx_invoices_sr_id">
      <column name="service_request_id"/>
    </createIndex>
  </changeSet>

  <!-- ── MEDIA ── -->
  <changeSet id="012" author="bizcore">
    <createTable tableName="media">
      <column name="id" type="uuid">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="business_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="url" type="varchar(1024)">
        <constraints nullable="false"/>
      </column>
      <column name="type" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="text"/>
      <column name="created_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint
      constraintName="fk_media_business"
      baseTableName="media"
      baseColumnNames="business_id"
      referencedTableName="businesses"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex tableName="media" indexName="idx_media_business_id">
      <column name="business_id"/>
    </createIndex>
    <createIndex tableName="media" indexName="idx_media_type">
      <column name="type"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
