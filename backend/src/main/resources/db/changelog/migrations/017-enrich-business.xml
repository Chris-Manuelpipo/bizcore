<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!--
    Migration 017 — ENRICHIR BUSINESS
    - Ajouter type_of_involved_actors (TEXT) — types d'acteurs impliqués
    - Ajouter required_job_profiles (TEXT) — profils métier requis
    
    MCD BizCore : BUSINESS a les champs manquants du sujet
  -->

  <changeSet id="017-add-business-type-involved-actors" author="bizcore">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="businesses"/>
      <not><columnExists tableName="businesses" columnName="type_of_involved_actors"/></not>
    </preConditions>
    <addColumn tableName="businesses">
      <column name="type_of_involved_actors" type="text"/>
    </addColumn>
  </changeSet>

  <changeSet id="017-add-business-required-job-profiles" author="bizcore">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="businesses"/>
      <not><columnExists tableName="businesses" columnName="required_job_profiles"/></not>
    </preConditions>
    <addColumn tableName="businesses">
      <column name="required_job_profiles" type="text"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
